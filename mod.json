{
  "geode": "5.8.2",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081"
  },
  "id": "yourname.motionblur",
  "name": "Motion Blur",
  "version": "v1.0.0",
  "developer": "YourName",
  "description": "Adds motion blur like in CapCut with adjustable strength",
  "settings": {
    "enabled": {
      "name": "Enabled",
      "description": "Toggle motion blur on/off",
      "type": "bool",
      "default": true
    },
    "strength": {
      "name": "Strength",
      "description": "Motion blur intensity (0 = off, 1 = max)",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "control": "slider"
    }
  }
}
